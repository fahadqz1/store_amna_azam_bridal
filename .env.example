# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email Service
RESEND_API_KEY=your_resend_api_key

# PaymentGateway (when configured)
PAYMENT_PROVIDER_API_KEY=your_payment_provider_key
PAYMENT_PROVIDER_SECRET=your_payment_provider_secret

# PostEx Shipping Integration
POSTEX_API_KEY=your_postex_api_key
POSTEX_API_URL=https://api.postex.pk

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
